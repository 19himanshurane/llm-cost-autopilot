# Copy this file to .env and fill in real values.
# The system runs in MOCK mode automatically for any provider whose key is missing,
# so you can build and test the full pipeline before you have API access.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Force mock mode for ALL providers regardless of keys present (useful for CI / demos)
FORCE_MOCK_MODE=false
